# Copy to deploy/.env, replace every placeholder. Never commit actual secrets.
DATABASE_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
JWT_SECRET=replace-with-at-least-48-random-characters
DEMO_PASSWORD=replace-with-at-least-12-random-characters
# DeepSeek chat + BM25 keyword retrieval; never pass its key to DashScope.
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
RETRIEVAL_MODE=keyword
# For hybrid retrieval, set RETRIEVAL_MODE=hybrid and supply this separate key.
# For DashScope chat as well, set CHAT_PROVIDER=dashscope.
DASHSCOPE_API_KEY=
AMAP_MCP_ENABLED=false
AMAP_WEB_SERVICE_KEY=
# Configure your workspace/region-specific endpoints if required by your account.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank


# Use 0.0.0.0 only for the explicitly public server deployment.
WEB_BIND_ADDRESS=127.0.0.1
MAP_MINUTE_LIMIT=30
MAP_DAY_LIMIT=200
MAP_GLOBAL_DAY_LIMIT=1000
